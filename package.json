{
  "name": "yqhub",
  "version": "0.4.3",
  "private": true,
  "author": "fishknowsss",
  "productName": "YQhub",
  "description": "YQhub 小云雀工作台",
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "electron:typecheck": "tsc -p tsconfig.electron.json",
    "electron:build": "npm run electron:typecheck && node scripts/clean-electron-build.mjs && vite build -c vite.electron.config.ts && node scripts/copy-preload.mjs",
    "icons:build": "node scripts/generate-icons.mjs",
    "electron:start": "npm run build && npm run electron:build && electron dist-electron/electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run electron:build",
    "dist": "npm run check && electron-builder --publish never",
    "dist:dir": "npm run check && electron-builder --dir --publish never",
    "dist:mac": "npm run check && electron-builder --mac --arm64 --publish never",
    "dist:win": "npm run check && electron-builder --win --x64 --publish never",
    "release:bundle": "node scripts/prepare-release.mjs",
    "release:local": "npm run dist:mac && npm run dist:win && npm run release:bundle"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.4.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.15"
  },
  "build": {
    "appId": "com.fishknowsss.yqhub",
    "productName": "YQhub",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.video",
      "icon": "build/icon.icns",
      "target": [
        "dmg"
      ],
      "identity": null
    },
    "dmg": {
      "artifactName": "YQhub-${version}-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "YQhub-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "allowToChangeInstallationDirectory": false
    }
  }
}
