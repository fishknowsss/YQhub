{
  "name": "yq-local-video-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/electron/main.js",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "electron:typecheck": "tsc -p tsconfig.electron.json",
    "electron:build": "npm run electron:typecheck && vite build -c vite.electron.config.ts",
    "electron:start": "npm run build && npm run electron:build && electron dist-electron/electron/main.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run test && npm run build && npm run electron:build"
  },
  "dependencies": {
    "electron-store": "^11.0.2",
    "lucide-react": "^0.561.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^42.4.0",
    "jsdom": "^27.2.0",
    "typescript": "^5.9.3",
    "vite": "^8.0.16",
    "vitest": "^4.0.15"
  }
}
